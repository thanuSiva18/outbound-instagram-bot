    {
      "parameters": {
        "jsCode": "// Preserve the ORIGINAL \"Lead date\" across progressive writes.\n// Append-or-Update overwrites every mapped column, so without this a lead that\n// spans a month boundary would silently have its capture month rewritten.\nconst lead = $('Normalize').first().json;\n\nconst existing = $input.all()\n  .map((i) => i.json)\n  .find((r) => r && String(r.ig_user_id || '') === String(lead.ig_user_id));\n\nconst original = existing ? String(existing['Lead date'] || '').trim() : '';\n\nreturn [{\n  json: {\n    ...lead,\n    lead_date: original || lead.lead_date,\n    is_new_row: !existing\n  }\n}];"
      },
