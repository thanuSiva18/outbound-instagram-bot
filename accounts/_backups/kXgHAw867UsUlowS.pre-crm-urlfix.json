    {
      "parameters": {
        "jsCode": "// Normalize one ManyChat viral-flow message into a single clean lead object.\n// ManyChat sends the literal merge tag (e.g. \"{{cuf_viral_email}}\") when a field is\n// still empty, so those must be scrubbed or they land in the sheet as junk.\nconst b = $('Webhook — viral lead').first().json.body || {};\n\nconst clean = (v) => {\n  v = (v == null ? '' : String(v)).trim();\n  if (/\\{\\{.*\\}\\}/.test(v)) return '';\n  if (/^(null|undefined)$/i.test(v)) return '';\n  return v;\n};\n\nconst ig_user_id = clean(b.ig_user_id);\nif (!ig_user_id) {\n  throw new Error('ig_user_id missing — cannot key the sheet row');\n}\n\nconst destination = clean(b.destination);\nconst travel_date = clean(b.travel_date);\nconst email = clean(b.email);\nconst contact_number = clean(b.contact_number);\n\n// pax: \"4 people\" -> \"4\"\nconst travelers = (clean(b.travelers).match(/\\d+/) || [''])[0];\n\n// phone: digits only, strip a leading 00 international prefix\nlet phone_digits = contact_number.replace(/\\D/g, '');\nif (phone_digits.startsWith('00')) phone_digits = phone_digits.slice(2);\nconst phone_valid = phone_digits.length >= 10;\n\n// Assignee must match the sheet values exactly — normalize casing/spelling drift\nconst a = clean(b.assignee);\nconst assignee = /^jasmine$/i.test(a) ? 'Jasmine'\n  : /^jen?s?n?ica$/i.test(a) ? 'Jensica'\n  : a;\n\nconst complete = Boolean(destination && travel_date && travelers && email && phone_valid);\nconst any_field = Boolean(destination || travel_date || travelers || email || contact_number);\nconst status = complete ? 'qualified' : (any_field ? 'in_progress' : 'new');\n\n// Lead date — IST \"Month YYYY\", identical format to the existing flows\nconst d = new Date();\nconst ist = new Date(d.getTime() + (5.5 * 60 + d.getTimezoneOffset()) * 60000);\nconst lead_date = `${ist.toLocaleString('en-US', { month: 'long' })} ${ist.getFullYear()}`;\n\nreturn [{\n  json: {\n    ig_user_id,\n    ig_username: clean(b.ig_username),\n    name: clean(b.name),\n    destination,\n    travel_date,\n    travelers,\n    email,\n    contact_number,\n    phone_digits,\n    assignee,\n    status,\n    complete,\n    lead_date,\n    step: clean(b.step)\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        60,
